{
  "info": {
    "name": "Zero Mile Delivery API",
    "description": "Complete API collection for Zero Mile Delivery System",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "Get All Parcels",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/parcels",
          "host": ["{{baseUrl}}"],
          "path": ["parcels"]
        }
      },
      "response": []
    },
    {
      "name": "Get Parcel by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/parcels/1",
          "host": ["{{baseUrl}}"],
          "path": ["parcels", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Track Parcel",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/parcels/track/ZM123456",
          "host": ["{{baseUrl}}"],
          "path": ["parcels", "track", "ZM123456"]
        }
      },
      "response": []
    },
    {
      "name": "Get Parcels by Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/parcels/status/Pending",
          "host": ["{{baseUrl}}"],
          "path": ["parcels", "status", "Pending"]
        }
      },
      "response": []
    },
    {
      "name": "Create Parcel",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"John Doe\",\n  \"deliveryAddress\": \"123 Main Street, Anytown, ST 12345\",\n  \"contactNumber\": \"+1-555-123-4567\",\n  \"parcelSize\": \"Medium\",\n  \"weight\": 2.5,\n  \"vendor\": \"ABC Logistics\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/parcels",
          "host": ["{{baseUrl}}"],
          "path": ["parcels"]
        }
      },
      "response": []
    },
    {
      "name": "Update Parcel",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"John Doe Updated\",\n  \"deliveryAddress\": \"456 Updated Street, Newtown, ST 54321\",\n  \"contactNumber\": \"+1-555-987-6543\",\n  \"parcelSize\": \"Large\",\n  \"weight\": 3.0,\n  \"status\": \"In Transit\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/parcels/1",
          "host": ["{{baseUrl}}"],
          "path": ["parcels", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Parcel",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/parcels/1",
          "host": ["{{baseUrl}}"],
          "path": ["parcels", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Get Dashboard Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/dashboard/stats",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard", "stats"]
        }
      },
      "response": []
    },
    {
      "name": "Create Bulk Parcels",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"parcels\": [\n    {\n      \"customerName\": \"Alice Smith\",\n      \"deliveryAddress\": \"789 Oak Avenue, Springfield, IL 62701\",\n      \"contactNumber\": \"+1-555-111-2222\",\n      \"parcelSize\": \"Small\",\n      \"weight\": 1.2,\n      \"vendor\": \"FastShip Co\"\n    },\n    {\n      \"customerName\": \"Bob Johnson\",\n      \"deliveryAddress\": \"321 Pine Road, Madison, WI 53703\",\n      \"contactNumber\": \"+1-555-333-4444\",\n      \"parcelSize\": \"Large\",\n      \"weight\": 4.8,\n      \"vendor\": \"QuickDelivery Inc\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/parcels/bulk",
          "host": ["{{baseUrl}}"],
          "path": ["parcels", "bulk"]
        }
      },
      "response": []
    }
  ]
}
